<mxfile host="app.diagrams.net" type="device">
  <!-- 骨架模板:演示「图注 + 汇流点连线 + 鉴权页」。绘图 agent 据此扩展为:
       鉴权页 1 页 + 每个用户角色/权限的业务流程各 1 页(如 流程-普通用户 / 流程-管理员(管理·审计))。
       规则:每页放图注;节点标签写「做了什么」业务语言、不写函数名;边标签带白底防压字。 -->
  <diagram name="流程-示例角色" id="page-flow">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="f-start" value="开始" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="360" y="40" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="f-step1" value="用户发起操作&#10;(示例;绘图 agent 替换)" style="whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="140" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="f-junc" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="415" y="240" width="10" height="10" as="geometry" />
        </mxCell>
        <mxCell id="f-a" value="分支 A" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="250" y="330" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="f-b" value="分支 B" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="470" y="330" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="f-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="f-start" target="f-step1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f-trunk" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="f-step1" target="f-junc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f-fan1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="f-junc" target="f-a">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f-fan2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="f-junc" target="f-b">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- 图注(legend):每页放一个;颜色/形状含义。绘图 agent 按本页实际用到的节点类型增减 -->
        <mxCell id="f-legend" value="图注" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;verticalAlign=top;align=left;fontStyle=1;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="220" height="160" as="geometry" />
        </mxCell>
        <mxCell id="f-lg1" value="开始 / 结束" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="52" y="70" width="90" height="24" as="geometry" /></mxCell>
        <mxCell id="f-lg2" value="处理步骤" style="whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="52" y="102" width="90" height="24" as="geometry" /></mxCell>
        <mxCell id="f-lg3" value="判断" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="52" y="134" width="90" height="30" as="geometry" /></mxCell>
        <mxCell id="f-lg4" value="失败 / 拒绝" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="152" y="70" width="96" height="24" as="geometry" /></mxCell>
        <mxCell id="f-lg5" value="●&#10;汇流点(一对多)" style="text;html=1;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="152" y="102" width="96" height="40" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="鉴权" id="page-auth">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="a-req" value="请求 + 携带凭证&#10;(Token/Session)" style="whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="a-check" value="校验凭证是否有效?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="270" y="50" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="a-ok" value="放行 → 业务处理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="520" y="45" width="150" height="40" as="geometry" />
        </mxCell>
        <mxCell id="a-no" value="401 拒绝 / 跳转登录" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="295" y="200" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="a-e1" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="a-req" target="a-check">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a-e2" value="是" style="edgeStyle=orthogonalEdgeStyle;html=1;labelBackgroundColor=#ffffff;jettySize=auto;" edge="1" parent="1" source="a-check" target="a-ok">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a-e3" value="否" style="edgeStyle=orthogonalEdgeStyle;html=1;labelBackgroundColor=#ffffff;jettySize=auto;" edge="1" parent="1" source="a-check" target="a-no">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- 图注(legend):鉴权页同样放一个 -->
        <mxCell id="a-legend" value="图注" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;verticalAlign=top;align=left;fontStyle=1;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="320" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="a-lg1" value="放行 / 成功" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="52" y="350" width="96" height="24" as="geometry" /></mxCell>
        <mxCell id="a-lg2" value="判断" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="158" y="348" width="90" height="30" as="geometry" /></mxCell>
        <mxCell id="a-lg3" value="拒绝 / 失败" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="52" y="392" width="96" height="24" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
