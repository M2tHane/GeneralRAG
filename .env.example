# =====================================================================
# rag-server 环境变量模板 —— 复制为 .env 并填入真实值。
# ⚠ 本文件只放占位符，禁止写入任何真实密钥；.env 已被 .gitignore 排除。
# 用法：cp .env.example .env && 编辑 .env
# 启动：cd rag-server && set -a && source ../.env && set +a && mvn spring-boot:run
# 代码侧唯一读取点：rag-server/src/main/resources/application.yaml（${ENV_VAR:默认}）
# =====================================================================

# ============================== 必填：模型服务密钥 ==============================
# 三个密钥通常相同（同一模型服务账号）
CHAT_MODEL_API_KEY=
EMBEDDING_API_KEY=
RERANK_MODEL_API_KEY=

# ============================== 模型端点与模型名 ==============================
# true=启动时探活 embedding 服务并校验维度，失败拒绝启动；模型服务后启动的场景可置 false
RAG_MODELS_STARTUP_CHECK=true
# 聊天模型：OpenAI 兼容端点（DashScope 填 .../compatible-mode/v1）
CHAT_MODEL_BASE_URL=
CHAT_MODEL_NAME=
# 向量模型：OpenAI 兼容端点；输出维度必须等于 application.yaml 的 rag.models.embedding.dimensions(1024)
EMBEDDING_BASE_URL=
EMBEDDING_MODEL_NAME=
# 重排模型：必须是裸域名（如 https://dashscope.aliyuncs.com）——
# 应用自动拼接原生端点 /api/v1/services/rerank/text-rerank/text-rerank，
# 填带路径的 base-url 会双重拼接导致 HTTP 400
RERANK_MODEL_BASE_URL=
RERANK_MODEL_NAME=qwen3.7-text-rerank

# ============================== 可选：本地基础设施 ==============================
# 留空时使用 application.yaml 默认值；与 docker-compose.yml 默认一致
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=rag
MYSQL_USER=rag
MYSQL_PASSWORD=rag-pass
ES_URIS=http://localhost:9200
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ============================== 可选：行为开关 ==============================
# 检索模式：VECTOR | HYBRID | HYBRID_RERANK（默认 HYBRID_RERANK）
RAG_RETRIEVAL_MODE=HYBRID_RERANK
# 拒答双口径阈值：重排生效时用 rerank 阈值；降级/未启用重排时用 cosine 阈值
RAG_REFUSAL_ENABLED=true
RAG_REFUSAL_RERANK_THRESHOLD=0.65
RAG_REFUSAL_COSINE_THRESHOLD=0.30
# Answerability 证据充分性判定（R4）：低分直拒，其余交给 LLM Judge
# enabled=false 时退回旧"单阈值拒答"行为（仅对照用）
RAG_ANSWERABILITY_ENABLED=true
# Judge 失败降级：false=退回旧阈值行为放行（标注降级）；true=保守拒答
RAG_ANSWERABILITY_FAIL_CLOSED=false
# Judge 超时（秒）：同时作为 Judge HTTP connect/read timeout（R4.1 单一超时语义）
RAG_ANSWERABILITY_JUDGE_TIMEOUT_SECONDS=15
RAG_ANSWERABILITY_MAX_CONCURRENT_JUDGES=4
RAG_ANSWERABILITY_BULKHEAD_WAIT_MS=500
# PDF 解析器：pdfbox（文本层，默认）| mineru（扫描件/复杂版面 OCR，需 MINERU_BASE_URL）
RAG_INGESTION_PDF_PARSER=pdfbox
# mineru-api 地址与超时（秒）；使用 mineru 解析器时必填地址
MINERU_BASE_URL=
MINERU_TIMEOUT_SECONDS=600
